{% set fs = sponsors.tiers | footerSponsors %}
<footer class="site-footer">
  <svg class="treeline treeline-footer" viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true">
    <path class="t1" d="{% treeline 7, 96, 30, 70, 3.2 %}"/>
    <path class="t2" d="{% treeline 3, 97, 20, 52, 2.6 %}"/>
  </svg>

  <section class="partners" aria-labelledby="partners-h">
    <div class="wrap">
      <h2 id="partners-h" class="eyebrow">Official Partners</h2>
      <ul class="partner-row">
        <li class="partner partner-title">
          <a href="/sponsors/#title">
            {% if sponsors.title.name %}
              {% if sponsors.title.logo %}<img src="{{ sponsors.title.logo }}" alt="{{ sponsors.title.name }}">{% else %}<span class="partner-name">{{ sponsors.title.name }}</span>{% endif %}
              <small>Presenting Sponsor</small>
            {% else %}
              <span class="partner-name">Your brand here</span><small>{{ sponsors.title.availableText }}</small>
            {% endif %}
          </a>
        </li>
        {% for s in fs %}
        <li class="partner">
          {% if s.url %}<a href="{{ s.url }}" target="_blank" rel="noopener">{% else %}<a href="/sponsors/">{% endif %}
            {% if s.logo %}<img src="{{ s.logo }}" alt="{{ s.name }}" loading="lazy">{% else %}<span class="partner-name">{{ s.name }}</span>{% endif %}
            {% if s.note %}<small>{{ s.note }}</small>{% endif %}
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  <div class="wrap footer-grid">
    <div class="footer-brand">
      <img src="/assets/img/logo-320.png" alt="{{ site.name }} logo" width="96" height="100" loading="lazy">
      <p>{{ site.tagline }}</p>
    </div>
    <div>
      <h3>{{ site.year }} dates</h3>
      <ul class="plain">
        {% for w in site.weekends %}<li><b>{{ w.label }}</b> · {{ w.dates }}</li>{% endfor %}
      </ul>
      <p class="muted">{{ site.venue.name }}<br>{{ site.venue.street }}, {{ site.venue.city }}</p>
    </div>
    <div>
      <h3>Explore</h3>
      <ul class="plain">
        {% for item in nav %}{% if item.url != "/" %}<li><a href="{{ item.url }}">{{ item.label }}</a></li>{% endif %}{% endfor %}
        <li><a href="{{ site.links.livestream }}" target="_blank" rel="noopener">Livestream ↗</a></li>
      </ul>
    </div>
    <div>
      <h3>Contact</h3>
      <ul class="plain">
        <li><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></li>
        <li><a href="tel:{{ site.contact.phoneHref }}">{{ site.contact.phone }}</a> <span class="muted">({{ site.contact.phoneNote | lower }})</span></li>
      </ul>
      <div class="social">
        <a href="{{ site.links.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" class="dot"/></svg></a>
        <a href="{{ site.links.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"/></svg></a>
      </div>
    </div>
  </div>
  <div class="wrap footer-base">
    <p>© 2022–{{ site.year }} {{ site.name }}. All registration, forms and payments are handled by our partners' secure sites.</p>
  </div>
</footer>
